#!/usr/bin/env bash
# Gestor seguro de archivos para dominios en PiruluGCP

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"

check_root

ACTION="$1"
TARGET_PATH="$2"
PARAM1="$3"
PARAM2="$4"

# Validacion de seguridad: el objetivo debe residir en /home o /var/www
validate_safe_path() {
    local path="$1"
    if [ -z "$path" ]; then
        exit_error "Ruta de archivo o directorio requerida"
    fi

    local real
    real=$(realpath -m "$path" 2>/dev/null)
    if [[ ! "$real" =~ ^/home/ ]] && [[ ! "$real" =~ ^/var/www/ ]]; then
        exit_error "Acceso denegado fuera de directorios de usuario"
    fi
}

case "$ACTION" in
    list)
        validate_safe_path "$TARGET_PATH"
        if [ ! -d "$TARGET_PATH" ]; then
            exit_error "El directorio no existe: $TARGET_PATH"
        fi

        echo "{\"status\":\"success\",\"path\":\"$TARGET_PATH\"}"
        ;;

    mkdir)
        validate_safe_path "$TARGET_PATH"
        OWNER_USER="$PARAM1"
        mkdir -p "$TARGET_PATH"
        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown -R "${OWNER_USER}:${OWNER_USER}" "$TARGET_PATH"
        fi
        chmod 755 "$TARGET_PATH"
        echo "{\"status\":\"success\",\"message\":\"Carpeta creada correctamente\"}"
        ;;

    touch)
        validate_safe_path "$TARGET_PATH"
        OWNER_USER="$PARAM1"
        touch "$TARGET_PATH"
        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown "${OWNER_USER}:${OWNER_USER}" "$TARGET_PATH"
        fi
        chmod 644 "$TARGET_PATH"
        echo "{\"status\":\"success\",\"message\":\"Archivo creado correctamente\"}"
        ;;

    delete)
        validate_safe_path "$TARGET_PATH"
        if [ -e "$TARGET_PATH" ]; then
            rm -rf "$TARGET_PATH"
            echo "{\"status\":\"success\",\"message\":\"Elemento eliminado correctamente\"}"
        else
            exit_error "El archivo o carpeta no existe"
        fi
        ;;

    chmod)
        validate_safe_path "$TARGET_PATH"
        MODE="$PARAM1"
        if [[ "$MODE" =~ ^[0-7]{3,4}$ ]]; then
            chmod "$MODE" "$TARGET_PATH"
            echo "{\"status\":\"success\",\"message\":\"Permisos cambiados a $MODE\"}"
        else
            exit_error "Modo de permisos invalido: $MODE"
        fi
        ;;

    chown)
        validate_safe_path "$TARGET_PATH"
        OWNER_USER="$PARAM1"
        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown -R "${OWNER_USER}:${OWNER_USER}" "$TARGET_PATH"
            echo "{\"status\":\"success\",\"message\":\"Propietario actualizado\"}"
        else
            exit_error "Usuario invalido"
        fi
        ;;

    unzip)
        validate_safe_path "$TARGET_PATH"
        DEST_DIR="$PARAM1"
        OWNER_USER="$PARAM2"
        validate_safe_path "$DEST_DIR"

        if [ ! -f "$TARGET_PATH" ]; then
            exit_error "Archivo ZIP no encontrado"
        fi

        mkdir -p "$DEST_DIR"
        if command -v unzip >/dev/null 2>&1; then
            unzip -o "$TARGET_PATH" -d "$DEST_DIR" >/dev/null 2>&1
        else
            python3 -c "import zipfile; zipfile.ZipFile('$TARGET_PATH').extractall('$DEST_DIR')"
        fi

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown -R "${OWNER_USER}:${OWNER_USER}" "$DEST_DIR"
        fi

        echo "{\"status\":\"success\",\"message\":\"Archivo ZIP extraido correctamente\"}"
        ;;

    copy)
        SRC_PATH="$TARGET_PATH"
        DEST_PATH="$PARAM1"
        OWNER_USER="$PARAM2"
        validate_safe_path "$SRC_PATH"
        validate_safe_path "$DEST_PATH"

        if [ ! -e "$SRC_PATH" ]; then
            exit_error "El elemento de origen no existe: $SRC_PATH"
        fi

        DEST_PARENT=$(dirname "$DEST_PATH")
        mkdir -p "$DEST_PARENT"

        cp -r "$SRC_PATH" "$DEST_PATH"

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown -R "${OWNER_USER}:${OWNER_USER}" "$DEST_PATH"
        fi
        echo "{\"status\":\"success\",\"message\":\"Elemento copiado correctamente\"}"
        ;;

    rename|move)
        SRC_PATH="$TARGET_PATH"
        DEST_PATH="$PARAM1"
        OWNER_USER="$PARAM2"
        validate_safe_path "$SRC_PATH"
        validate_safe_path "$DEST_PATH"

        if [ ! -e "$SRC_PATH" ]; then
            exit_error "El elemento de origen no existe: $SRC_PATH"
        fi

        DEST_PARENT=$(dirname "$DEST_PATH")
        mkdir -p "$DEST_PARENT"

        mv -f "$SRC_PATH" "$DEST_PATH"

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown -R "${OWNER_USER}:${OWNER_USER}" "$DEST_PATH"
        fi
        echo "{\"status\":\"success\",\"message\":\"Elemento movido/renombrado correctamente\"}"
        ;;

    zip|compress)
        validate_safe_path "$TARGET_PATH"
        ZIP_DEST="$PARAM1"
        OWNER_USER="$PARAM2"
        validate_safe_path "$ZIP_DEST"

        if [ ! -e "$TARGET_PATH" ]; then
            exit_error "El archivo o carpeta no existe: $TARGET_PATH"
        fi

        PARENT_DIR=$(dirname "$TARGET_PATH")
        ITEM_NAME=$(basename "$TARGET_PATH")

        cd "$PARENT_DIR" || exit 1
        if command -v zip >/dev/null 2>&1; then
            zip -r -q "$ZIP_DEST" "$ITEM_NAME"
        else
            python3 -c "import zipfile, os
with zipfile.ZipFile('$ZIP_DEST', 'w', zipfile.ZIP_DEFLATED) as z:
    if os.path.isdir('$ITEM_NAME'):
        for root, dirs, files in os.walk('$ITEM_NAME'):
            for f in files:
                p = os.path.join(root, f)
                z.write(p, p)
    else:
        z.write('$ITEM_NAME', '$ITEM_NAME')"
        fi

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown "${OWNER_USER}:${OWNER_USER}" "$ZIP_DEST"
        fi
        chmod 644 "$ZIP_DEST"
        echo "{\"status\":\"success\",\"message\":\"Elemento comprimido correctamente en ZIP\"}"
        ;;

    import)
        SRC_FILE="$TARGET_PATH"
        DEST_FILE="$PARAM1"
        OWNER_USER="$PARAM2"
        validate_safe_path "$DEST_FILE"

        if [ ! -f "$SRC_FILE" ]; then
            exit_error "El archivo temporal no existe: $SRC_FILE"
        fi

        DEST_PARENT=$(dirname "$DEST_FILE")
        mkdir -p "$DEST_PARENT"

        mv -f "$SRC_FILE" "$DEST_FILE"

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown "${OWNER_USER}:${OWNER_USER}" "$DEST_FILE"
        fi
        chmod 644 "$DEST_FILE"
        echo "{\"status\":\"success\",\"message\":\"Archivo subido correctamente\"}"
        ;;

    write)
        validate_safe_path "$TARGET_PATH"
        TEMP_FILE="$PARAM1"
        OWNER_USER="$PARAM2"

        if [ ! -f "$TEMP_FILE" ]; then
            exit_error "El archivo temporal no existe: $TEMP_FILE"
        fi

        PARENT_DIR=$(dirname "$TARGET_PATH")
        mkdir -p "$PARENT_DIR"

        mv -f "$TEMP_FILE" "$TARGET_PATH"

        if [ -n "$OWNER_USER" ] && id "$OWNER_USER" >/dev/null 2>&1; then
            chown "${OWNER_USER}:${OWNER_USER}" "$TARGET_PATH"
        fi
        chmod 644 "$TARGET_PATH"
        echo "{\"status\":\"success\",\"message\":\"Archivo guardado correctamente\"}"
        ;;

    *)
        echo "Uso: pirulu-files <list|mkdir|touch|delete|chmod|chown|unzip|import|write|copy|rename|move|compress> <ruta> [param1] [param2]"
        exit 1
        ;;
esac
