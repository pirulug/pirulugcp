#!/usr/bin/env bash
# Gestor de Configuracion del Servidor y Actualizaciones del Panel para PiruluGCP

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/db-helper.sh"

check_root

ACTION="$1"
PARAM1="$2"
PARAM2="$3"
PARAM3="$4"

SSH_DIR="/root/.ssh"
PANEL_KEY_NAME="id_panel_deploy"
PANEL_KEY_PATH="${SSH_DIR}/${PANEL_KEY_NAME}"
PANEL_PUB_PATH="${PANEL_KEY_PATH}.pub"
PANEL_DIR="${PIRULU_INSTALL_DIR:-/usr/local/pirulugcp}"

usage() {
    echo "Uso: pirulu-server <get-config|set-hostname|set-timezone|generate-key|get-key|connect-git|update-panel|status-git> [params...]"
    exit 1
}

[ -z "$ACTION" ] && usage

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n' | sed 's/\\n$//'
}

setup_panel_ssh_env() {
    mkdir -p "$SSH_DIR"
    chmod 700 "$SSH_DIR"

    local ssh_config="${SSH_DIR}/config"
    if [ ! -f "$ssh_config" ]; then
        touch "$ssh_config"
        chmod 600 "$ssh_config"
    fi

    # Configurar StrictHostKeyChecking para GitHub / GitLab / Bitbucket
    for host in github.com gitlab.com bitbucket.org; do
        if ! grep -q "Host ${host}" "$ssh_config" 2>/dev/null; then
            cat <<EOF >> "$ssh_config"

Host ${host}
    HostName ${host}
    User git
    IdentityFile ${PANEL_KEY_PATH}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
EOF
        fi
    done
}

get_panel_ssh_command() {
    if [ -f "$PANEL_KEY_PATH" ]; then
        echo "ssh -i ${PANEL_KEY_PATH} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    else
        echo "ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
    fi
}

case "$ACTION" in
    get-config)
        HOSTNAME_VAL=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo "localhost")
        TIMEZONE_VAL=$(timedatectl show --property=Timezone --value 2>/dev/null)
        if [ -z "$TIMEZONE_VAL" ]; then
            if [ -f /etc/timezone ]; then
                TIMEZONE_VAL=$(cat /etc/timezone | tr -d '\n')
            elif [ -L /etc/localtime ]; then
                TIMEZONE_VAL=$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')
            else
                TIMEZONE_VAL="UTC"
            fi
        fi

        CURRENT_TIME=$(date "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null)
        SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
        [ -z "$SERVER_IP" ] && SERVER_IP="127.0.0.1"

        PUBLIC_KEY=""
        if [ -f "$PANEL_PUB_PATH" ]; then
            PUBLIC_KEY=$(cat "$PANEL_PUB_PATH" | tr -d '\r\n')
        fi

        GIT_CONNECTED=false
        REMOTE_URL=""
        CURRENT_BRANCH=""
        LAST_COMMIT=""
        LAST_AUTHOR=""
        LAST_MSG=""

        if [ -d "${PANEL_DIR}/.git" ]; then
            GIT_CONNECTED=true
            cd "$PANEL_DIR" || exit 1
            REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
            CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
            LAST_COMMIT=$(git log -1 --format="%H" 2>/dev/null || echo "")
            LAST_AUTHOR=$(git log -1 --format="%an" 2>/dev/null || echo "")
            LAST_MSG=$(git log -1 --format="%s" 2>/dev/null || echo "")
        fi

        PANEL_DOMAIN_VAL=""
        if [ -f "/etc/nginx/sites-available/pirulugcp.conf" ]; then
            PANEL_DOMAIN_VAL=$(grep -E '^\s*server_name\s+' /etc/nginx/sites-available/pirulugcp.conf | head -n 1 | awk '{print $2}' | sed 's/;//' | grep -v '^_$' || echo "")
        fi

        echo "{\"status\":\"success\",\"hostname\":\"$(json_escape "$HOSTNAME_VAL")\",\"panel_domain\":\"$(json_escape "$PANEL_DOMAIN_VAL")\",\"timezone\":\"$(json_escape "$TIMEZONE_VAL")\",\"current_time\":\"$(json_escape "$CURRENT_TIME")\",\"server_ip\":\"$(json_escape "$SERVER_IP")\",\"public_key\":\"$(json_escape "$PUBLIC_KEY")\",\"git_connected\":$GIT_CONNECTED,\"remote_url\":\"$(json_escape "$REMOTE_URL")\",\"branch\":\"$(json_escape "$CURRENT_BRANCH")\",\"last_commit\":\"$(json_escape "$LAST_COMMIT")\",\"last_author\":\"$(json_escape "$LAST_AUTHOR")\",\"last_message\":\"$(json_escape "$LAST_MSG")\"}"
        ;;

    set-hostname)
        NEW_HOSTNAME="$PARAM1"
        [ -z "$NEW_HOSTNAME" ] && exit_error "Nombre de host requerido"

        # Validar caracteres validos para hostname o IP
        NEW_HOSTNAME=$(echo "$NEW_HOSTNAME" | tr -cd 'a-zA-Z0-9.-')
        [ -z "$NEW_HOSTNAME" ] && exit_error "Nombre de host invalido"

        log_info "Configurando nuevo hostname del servidor: $NEW_HOSTNAME"

        # Aplicar mediante hostnamectl si systemd esta activo, o directamente
        if command -v hostnamectl >/dev/null 2>&1 && systemctl is-active --quiet systemd-hostnamed 2>/dev/null; then
            hostnamectl set-hostname "$NEW_HOSTNAME" 2>/dev/null || true
        else
            hostname "$NEW_HOSTNAME" 2>/dev/null || true
        fi

        echo "$NEW_HOSTNAME" > /etc/hostname

        # Actualizar /etc/hosts si no existe la entrada
        if ! grep -q "$NEW_HOSTNAME" /etc/hosts; then
            sed -i "/127.0.1.1/d" /etc/hosts 2>/dev/null || true
            echo "127.0.1.1 $NEW_HOSTNAME" >> /etc/hosts
        fi

        echo "{\"status\":\"success\",\"message\":\"Nombre de servidor actualizado a $NEW_HOSTNAME\",\"hostname\":\"$(json_escape "$NEW_HOSTNAME")\"}"
        ;;

    set-panel-domain)
        PANEL_DOMAIN="$PARAM1"
        PANEL_CONF="/etc/nginx/sites-available/pirulugcp.conf"
        SOCK_FILE="/run/php/pirulugcp-panel.sock"
        [ ! -S "$SOCK_FILE" ] && SOCK_FILE=$(find /run/php/ -name "php*-fpm.sock" 2>/dev/null | head -n 1)

        if [ -n "$PANEL_DOMAIN" ]; then
            PANEL_DOMAIN=$(echo "$PANEL_DOMAIN" | tr -cd 'a-zA-Z0-9.-' | tr '[:upper:]' '[:lower:]')
        fi

        log_info "Configurando dominio de acceso al panel: ${PANEL_DOMAIN:-ninguno}"

        cat <<EOF > "$PANEL_CONF"
# VirtualHost principal del panel PiruluGCP (Puerto 8083)
server {
    listen 8083;
    listen [::]:8083;
    server_name ${PANEL_DOMAIN:-_} _;

    root ${PANEL_DIR}/cp-web/public;
    index index.php index.html;

    location / {
        try_files \$uri \$uri/ /index.php?\$args;
    }

    location /phpmyadmin {
        root ${PANEL_DIR}/cp-web/public;
        index index.php;

        location ~ ^/phpmyadmin/(.+\.php)$ {
            include fastcgi_params;
            fastcgi_pass unix:${SOCK_FILE};
            fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        }

        location ~* ^/phpmyadmin/(.+\.(jpg|jpeg|gif|css|png|js|ico|html|xml|txt))$ {
            root ${PANEL_DIR}/cp-web/public;
        }
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:${SOCK_FILE};
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
    }

    location ~ /\.ht {
        deny all;
    }

    access_log /var/log/nginx/pirulugcp_access.log;
    error_log /var/log/nginx/pirulugcp_error.log;
}
EOF

        # Si se configuro un subdominio/dominio, agregar proxy inverso en puerto 80
        if [ -n "$PANEL_DOMAIN" ]; then
            cat <<EOF >> "$PANEL_CONF"

# Acceso directo al panel mediante ${PANEL_DOMAIN} en puerto 80 (HTTP)
server {
    listen 80;
    listen [::]:80;
    server_name ${PANEL_DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF
            # Agregar entrada en /etc/hosts si no existe
            if ! grep -qw "$PANEL_DOMAIN" /etc/hosts 2>/dev/null; then
                echo "127.0.0.1 $PANEL_DOMAIN" >> /etc/hosts
            fi
        fi

        ln -sf "$PANEL_CONF" /etc/nginx/sites-enabled/pirulugcp.conf

        if nginx -t >/dev/null 2>&1; then
            systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || nginx -s reload 2>/dev/null || true
            echo "{\"status\":\"success\",\"message\":\"Dominio del panel configurado a ${PANEL_DOMAIN:-ninguno}\",\"panel_domain\":\"$(json_escape "$PANEL_DOMAIN")\"}"
        else
            log_error "Error de sintaxis en Nginx al configurar dominio del panel"
            echo "{\"status\":\"error\",\"message\":\"Error de sintaxis en la configuracion de Nginx\"}"
            exit 1
        fi
        ;;

    set-timezone)
        NEW_TIMEZONE="$PARAM1"
        [ -z "$NEW_TIMEZONE" ] && exit_error "Zona horaria requerida"

        ZONEINFO_FILE="/usr/share/zoneinfo/${NEW_TIMEZONE}"
        if [ ! -f "$ZONEINFO_FILE" ]; then
            exit_error "Zona horaria no valida en el sistema: $NEW_TIMEZONE"
        fi

        log_info "Configurando nueva zona horaria: $NEW_TIMEZONE"

        # Configurar en el sistema
        if command -v timedatectl >/dev/null 2>&1; then
            timedatectl set-timezone "$NEW_TIMEZONE" 2>/dev/null || true
        fi

        ln -sf "$ZONEINFO_FILE" /etc/localtime
        echo "$NEW_TIMEZONE" > /etc/timezone 2>/dev/null || true

        # Actualizar directiva date.timezone en todos los php.ini de PHP-FPM y CLI
        for ini in /etc/php/*/fpm/php.ini /etc/php/*/cli/php.ini; do
            if [ -f "$ini" ]; then
                if grep -q "^;*date.timezone" "$ini"; then
                    sed -i "s#^;*date.timezone =.*#date.timezone = ${NEW_TIMEZONE}#" "$ini"
                else
                    echo "date.timezone = ${NEW_TIMEZONE}" >> "$ini"
                fi
            fi
        done

        # Reiniciar servicios PHP-FPM para aplicar la nueva zona horaria
        systemctl restart "php*-fpm" 2>/dev/null || true
        systemctl restart pirulugcp-php 2>/dev/null || true

        CURRENT_TIME=$(date "+%Y-%m-%d %H:%M:%S %Z" 2>/dev/null)
        echo "{\"status\":\"success\",\"message\":\"Zona horaria actualizada a $NEW_TIMEZONE\",\"timezone\":\"$(json_escape "$NEW_TIMEZONE")\",\"current_time\":\"$(json_escape "$CURRENT_TIME")\"}"
        ;;

    generate-key)
        setup_panel_ssh_env
        rm -f "$PANEL_KEY_PATH" "$PANEL_PUB_PATH"

        log_info "Generando nueva clave SSH Ed25519 para actualizaciones del panel..."
        ssh-keygen -t ed25519 -C "panel-deploy@pirulugcp" -f "$PANEL_KEY_PATH" -N "" >/dev/null 2>&1
        chmod 600 "$PANEL_KEY_PATH"
        chmod 644 "$PANEL_PUB_PATH"

        PUB_KEY=$(cat "$PANEL_PUB_PATH" | tr -d '\r\n')
        echo "{\"status\":\"success\",\"message\":\"Clave SSH de actualizacion generada exitosamente\",\"public_key\":\"$(json_escape "$PUB_KEY")\"}"
        ;;

    get-key)
        setup_panel_ssh_env
        if [ ! -f "$PANEL_PUB_PATH" ]; then
            ssh-keygen -t ed25519 -C "panel-deploy@pirulugcp" -f "$PANEL_KEY_PATH" -N "" >/dev/null 2>&1
            chmod 600 "$PANEL_KEY_PATH"
            chmod 644 "$PANEL_PUB_PATH"
        fi
        PUB_KEY=$(cat "$PANEL_PUB_PATH" | tr -d '\r\n')
        echo "{\"status\":\"success\",\"public_key\":\"$(json_escape "$PUB_KEY")\"}"
        ;;

    connect-git)
        REPO_URL="$PARAM1"
        BRANCH="${PARAM2:-main}"
        IS_PRIVATE="${PARAM3:-0}"

        [ -z "$REPO_URL" ] && exit_error "URL del repositorio requerida"

        setup_panel_ssh_env
        export GIT_TERMINAL_PROMPT=0
        export GIT_SSH_COMMAND="$(get_panel_ssh_command)"

        cd "$PANEL_DIR" || exit 1

        # Inicializar repositorio si no existe .git
        if [ ! -d "${PANEL_DIR}/.git" ]; then
            git init >/dev/null 2>&1
            git config core.fileMode false
            git remote add origin "$REPO_URL" >/dev/null 2>&1 || git remote set-url origin "$REPO_URL"
        else
            git remote set-url origin "$REPO_URL" >/dev/null 2>&1 || git remote add origin "$REPO_URL"
        fi

        log_info "Vinculando panel PiruluGCP a repositorio remoto $REPO_URL (rama $BRANCH)..."

        FETCH_OUT=$(git fetch --prune origin 2>&1)
        FETCH_CODE=$?

        if [ $FETCH_CODE -ne 0 ]; then
            log_error "Error al obtener ramas remotas del panel: $FETCH_OUT"
            echo "{\"status\":\"error\",\"message\":\"Fallo al conectar con el repositorio. Verifica la URL y la Clave SSH en GitHub.\",\"log\":\"$(json_escape "$FETCH_OUT")\"}"
            exit 1
        fi

        # Detectar fallback de rama si no existe
        if ! git rev-parse --verify "origin/${BRANCH}" >/dev/null 2>&1; then
            if git rev-parse --verify "origin/main" >/dev/null 2>&1; then
                BRANCH="main"
            elif git rev-parse --verify "origin/master" >/dev/null 2>&1; then
                BRANCH="master"
            fi
        fi

        echo "{\"status\":\"success\",\"message\":\"Repositorio de actualizaciones vinculado correctamente\",\"branch\":\"$(json_escape "$BRANCH")\"}"
        ;;

    update-panel)
        BRANCH="${PARAM1:-main}"

        setup_panel_ssh_env
        export GIT_TERMINAL_PROMPT=0
        export GIT_SSH_COMMAND="$(get_panel_ssh_command)"

        cd "$PANEL_DIR" || exit 1

        if [ ! -d "${PANEL_DIR}/.git" ]; then
            exit_error "El directorio del panel no esta vinculado a un repositorio Git"
        fi

        log_info "Iniciando actualizacion del panel PiruluGCP..."

        FETCH_OUT=$(git fetch --prune origin 2>&1)
        FETCH_CODE=$?

        if [ $FETCH_CODE -ne 0 ]; then
            log_error "Error en git fetch para actualizacion del panel: $FETCH_OUT"
            echo "{\"status\":\"error\",\"message\":\"Error al descargar actualizaciones desde GitHub\",\"log\":\"$(json_escape "$FETCH_OUT")\"}"
            exit 1
        fi

        if ! git rev-parse --verify "origin/${BRANCH}" >/dev/null 2>&1; then
            if git rev-parse --verify "origin/main" >/dev/null 2>&1; then
                BRANCH="main"
            elif git rev-parse --verify "origin/master" >/dev/null 2>&1; then
                BRANCH="master"
            fi
        fi

        CHECKOUT_OUT=$(git checkout -B "$BRANCH" "origin/${BRANCH}" --force 2>&1)
        RESET_OUT=$(git reset --hard "origin/${BRANCH}" 2>&1)
        OUTPUT="${FETCH_OUT}"$'\n'"${CHECKOUT_OUT}"$'\n'"${RESET_OUT}"

        # Re-aplicar permisos de ejecucion y de almacenamiento
        chmod +x "${PANEL_DIR}/engine/bin/"* 2>/dev/null || true
        chown -R www-data:www-data "${PANEL_DIR}/cp-web" "${PANEL_DIR}/config" /var/lib/pirulugcp /var/log/pirulugcp 2>/dev/null || true

        # Reiniciar el servicio PHP-FPM del panel
        systemctl restart pirulugcp-php 2>/dev/null || true

        COMMIT_HASH=$(git log -1 --format="%H" 2>/dev/null || echo "")
        COMMIT_AUTHOR=$(git log -1 --format="%an" 2>/dev/null || echo "")
        COMMIT_MSG=$(git log -1 --format="%s" 2>/dev/null || echo "")

        log_info "Panel PiruluGCP actualizado con exito al commit $COMMIT_HASH"
        echo "{\"status\":\"success\",\"message\":\"Panel actualizado exitosamente\",\"branch\":\"$(json_escape "$BRANCH")\",\"commit_hash\":\"$(json_escape "$COMMIT_HASH")\",\"commit_author\":\"$(json_escape "$COMMIT_AUTHOR")\",\"commit_message\":\"$(json_escape "$COMMIT_MSG")\",\"log\":\"$(json_escape "$OUTPUT")\"}"
        ;;

    status-git)
        if [ ! -d "${PANEL_DIR}/.git" ]; then
            echo "{\"status\":\"not-connected\",\"message\":\"No hay repositorio de actualizaciones configurado\"}"
            exit 0
        fi

        cd "$PANEL_DIR" || exit 1
        REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
        CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
        COMMIT_HASH=$(git log -1 --format="%H" 2>/dev/null || echo "")
        COMMIT_AUTHOR=$(git log -1 --format="%an" 2>/dev/null || echo "")
        COMMIT_MSG=$(git log -1 --format="%s" 2>/dev/null || echo "")
        COMMIT_DATE=$(git log -1 --format="%cd" 2>/dev/null || echo "")

        echo "{\"status\":\"success\",\"connected\":true,\"remote_url\":\"$(json_escape "$REMOTE_URL")\",\"branch\":\"$(json_escape "$CURRENT_BRANCH")\",\"commit_hash\":\"$(json_escape "$COMMIT_HASH")\",\"commit_author\":\"$(json_escape "$COMMIT_AUTHOR")\",\"commit_message\":\"$(json_escape "$COMMIT_MSG")\",\"commit_date\":\"$(json_escape "$COMMIT_DATE")\"}"
        ;;

    *)
        usage
        ;;
esac
