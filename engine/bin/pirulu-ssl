#!/usr/bin/env bash
# Gestor de Certificados SSL Gratuitos (Let's Encrypt / Certbot) para PiruluGCP

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"

check_root

ACTION="$1"
USER="$2"
DOMAIN="$3"
EMAIL="$4"

usage() {
    echo "Uso: pirulu-ssl <issue|renew|delete|status> [usuario] [dominio] [email]"
    echo "Acciones:"
    echo "  issue <usuario> <dominio> [email]   Expedir e instalar certificado Let's Encrypt"
    echo "  renew                               Renovar todos los certificados vencidos"
    echo "  delete <usuario> <dominio>          Eliminar certificado SSL y volver a HTTP"
    echo "  status <dominio>                    Comprobar estado del certificado"
    exit 1
}

[ -z "$ACTION" ] && usage

case "$ACTION" in
    issue)
        [ -z "$USER" ] || [ -z "$DOMAIN" ] && usage
        validate_username "$USER"
        validate_domain "$DOMAIN"

        DOC_ROOT="${DEFAULT_USER_HOME}/${USER}/web/${DOMAIN}/public_html"
        if [ ! -d "$DOC_ROOT" ]; then
            exit_error "El DocumentRoot no existe: $DOC_ROOT"
        fi

        log_info "Iniciando expedicion de certificado SSL gratuito para: $DOMAIN"

        # Preparar directorio de desafio ACME
        mkdir -p "${DOC_ROOT}/.well-known/acme-challenge"
        chown -R "${USER}:${USER}" "${DOC_ROOT}/.well-known"
        chmod -R 755 "${DOC_ROOT}/.well-known"

        # Opciones de correo
        EMAIL_OPT="--register-unsafely-without-email"
        if [ -n "$EMAIL" ]; then
            EMAIL_OPT="--email $EMAIL --no-eff-email"
        fi

        # Ejecutar Certbot con plugin webroot
        certbot certonly --webroot \
            -w "$DOC_ROOT" \
            -d "$DOMAIN" \
            -d "www.${DOMAIN}" \
            --non-interactive \
            --agree-tos \
            $EMAIL_OPT >/dev/null 2>&1

        # Si el certificado para www falla por no tener registro DNS, reintentar solo con dominio raiz
        if [ ! -f "/etc/letsencrypt/live/${DOMAIN}/fullchain.pem" ]; then
            certbot certonly --webroot \
                -w "$DOC_ROOT" \
                -d "$DOMAIN" \
                --non-interactive \
                --agree-tos \
                $EMAIL_OPT >/dev/null 2>&1
        fi

        if [ -f "/etc/letsencrypt/live/${DOMAIN}/fullchain.pem" ]; then
            # Activar configuracion SSL en el servidor web
            "${SCRIPT_DIR}/pirulu-web" ssl-enable "$USER" "$DOMAIN"
            log_info "Certificado SSL Let's Encrypt activado para: $DOMAIN"
            echo "{\"status\":\"success\",\"message\":\"Certificado SSL Let's Encrypt instalado y activado correctamente\",\"domain\":\"$DOMAIN\"}"
        else
            exit_error "No se pudo obtener el certificado de Let's Encrypt. Verifica que los registros DNS apunten a este servidor."
        fi
        ;;

    renew)
        log_info "Ejecutando renovacion de certificados SSL..."
        certbot renew --quiet
        systemctl reload nginx >/dev/null 2>&1 || true
        systemctl reload apache2 >/dev/null 2>&1 || true
        echo "{\"status\":\"success\",\"message\":\"Certificados renovados exitosamente\"}"
        ;;

    delete)
        [ -z "$USER" ] || [ -z "$DOMAIN" ] && usage
        log_info "Eliminando certificado SSL para: $DOMAIN"

        certbot delete --cert-name "$DOMAIN" --non-interactive >/dev/null 2>&1 || true
        "${SCRIPT_DIR}/pirulu-web" ssl-disable "$USER" "$DOMAIN"
        echo "{\"status\":\"success\",\"message\":\"Certificado SSL removido para $DOMAIN\"}"
        ;;

    status|details)
        TARGET_DOM="$2"
        [ -z "$TARGET_DOM" ] && TARGET_DOM="$DOMAIN"
        [ -z "$TARGET_DOM" ] && usage

        CERT_FILE="/etc/letsencrypt/live/${TARGET_DOM}/fullchain.pem"
        KEY_FILE="/etc/letsencrypt/live/${TARGET_DOM}/privkey.pem"
        CHAIN_FILE="/etc/letsencrypt/live/${TARGET_DOM}/chain.pem"

        if [ -f "$CERT_FILE" ]; then
            python3 -c '
import sys, json, datetime, subprocess

cert_path = sys.argv[1]
key_path = sys.argv[2]
chain_path = sys.argv[3]
domain = sys.argv[4]

try:
    with open(cert_path, "r", encoding="utf-8", errors="ignore") as f:
        cert_raw = f.read()

    key_raw = ""
    try:
        with open(key_path, "r", encoding="utf-8", errors="ignore") as f:
            key_raw = f.read()
    except Exception:
        pass

    chain_raw = ""
    try:
        with open(chain_path, "r", encoding="utf-8", errors="ignore") as f:
            chain_raw = f.read()
    except Exception:
        pass

    subj = subprocess.check_output(["openssl", "x509", "-subject", "-noout", "-in", cert_path]).decode("utf-8", errors="ignore").replace("subject=", "").strip()
    issuer = subprocess.check_output(["openssl", "x509", "-issuer", "-noout", "-in", cert_path]).decode("utf-8", errors="ignore").replace("issuer=", "").strip()
    valid_from = subprocess.check_output(["openssl", "x509", "-startdate", "-noout", "-in", cert_path]).decode("utf-8", errors="ignore").split("=")[1].strip()
    valid_to = subprocess.check_output(["openssl", "x509", "-enddate", "-noout", "-in", cert_path]).decode("utf-8", errors="ignore").split("=")[1].strip()

    text_out = subprocess.check_output(["openssl", "x509", "-text", "-noout", "-in", cert_path]).decode("utf-8", errors="ignore")

    san = ""
    if "Subject Alternative Name:" in text_out:
        try:
            san = text_out.split("Subject Alternative Name:")[1].split("\n")[1].strip()
        except Exception:
            pass

    san_clean = san.replace("DNS:", "").strip()
    if not san_clean:
        san_clean = domain

    sig_algo = "sha256WithRSAEncryption"
    for line in text_out.splitlines():
        if "Signature Algorithm:" in line:
            sig_algo = line.split("Signature Algorithm:")[1].strip()
            break

    key_size = "2048 bit"
    for line in text_out.splitlines():
        if "Public-Key:" in line or "RSA Public-Key:" in line:
            key_size = line.split(":")[1].strip().replace("(", "").replace(")", "")
            break

    # Format issuer to clean readable string
    issuer_clean = issuer.replace("/", ", ").strip(", ")

    # Format subject
    subj_clean = domain
    if "CN=" in subj:
        subj_clean = subj.split("CN=")[1].split(",")[0].strip()

    try:
        exp_dt = datetime.datetime.strptime(valid_to, "%b %d %H:%M:%S %Y %Z")
    except Exception:
        try:
            exp_dt = datetime.datetime.strptime(valid_to, "%b %d %H:%M:%S %Y GMT")
        except Exception:
            exp_dt = datetime.datetime.now(datetime.timezone.utc)

    now_utc = datetime.datetime.now(datetime.timezone.utc)
    if exp_dt.tzinfo is None:
        exp_dt = exp_dt.replace(tzinfo=datetime.timezone.utc)

    days_left = max(0, (exp_dt - now_utc).days)

    cert_type = "Let'\''s Encrypt"
    if "Let'\''s Encrypt" not in issuer and "ISRG" not in issuer:
        cert_type = "Personalizado / CA"

    res = {
        "status": "success",
        "ssl_active": True,
        "domain": domain,
        "issued_to": subj_clean,
        "alternate": san_clean,
        "not_before": valid_from,
        "not_after": valid_to,
        "signature": sig_algo,
        "key_size": key_size,
        "issued_by": issuer_clean,
        "issuer": issuer_clean,
        "subject": subj_clean,
        "valid_from": valid_from,
        "expires": valid_to,
        "days_left": days_left,
        "san": san_clean,
        "type": cert_type,
        "cloudflare_compatible": True,
        "cert_pem": cert_raw,
        "key_pem": key_raw,
        "chain_pem": chain_raw
    }
    print(json.dumps(res))
except Exception as e:
    print(json.dumps({"status": "error", "message": str(e), "ssl_active": False, "domain": domain}))
' "$CERT_FILE" "$KEY_FILE" "$CHAIN_FILE" "$TARGET_DOM"
        else
            echo "{\"status\":\"success\",\"ssl_active\":false,\"domain\":\"$TARGET_DOM\",\"expires\":null,\"days_left\":0,\"type\":\"Sin SSL\",\"cloudflare_compatible\":true}"
        fi
        ;;

    *)
        usage
        ;;
esac
