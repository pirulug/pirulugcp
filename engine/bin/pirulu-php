#!/usr/bin/env bash
# Gestor de PHP-FPM Multi-Version y Configuracion php.ini para PiruluGCP

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/../lib/common.sh"

check_root

ACTION="$1"
PARAM1="$2"
PARAM2="$3"
PARAM3="$4"
PARAM4="$5"
PARAM5="$6"
PARAM6="$7"
PARAM7="$8"
PARAM8="$9"

usage() {
    echo "Uso: pirulu-php <versions|pool-add|pool-del|restart|get-ini|set-ini|save-raw-ini> [argumentos]"
    exit 1
}

[ -z "$ACTION" ] && usage

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/g' | tr -d '\n' | sed 's/\\n$//'
}

TPL_FILE="${PIRULU_ROOT}/engine/templates/php-fpm/pool.conf.tpl"

php_versions_list() {
    IFS="," read -r -a VERSIONS <<< "$AVAILABLE_PHP_VERSIONS"
    local json_list="["
    local first=1
    for ver in "${VERSIONS[@]}"; do
        local installed="false"
        local status="inactive"
        if command -v "php${ver}" >/dev/null 2>&1 || [ -d "/etc/php/${ver}" ]; then
            installed="true"
            if systemctl is-active --quiet "php${ver}-fpm" 2>/dev/null; then
                status="active"
            fi
        fi
        if [ $first -eq 0 ]; then
            json_list="${json_list},"
        fi
        json_list="${json_list}{\"version\":\"${ver}\",\"installed\":${installed},\"status\":\"${status}\"}"
        first=0
    done
    json_list="${json_list}]"
    echo "{\"status\":\"success\",\"versions\":${json_list}}"
}

php_pool_add() {
    local user="$1"
    local domain="$2"
    local version="$3"
    local doc_root="$4"
    local socket="$5"
    local web_root="${6:-${DEFAULT_USER_HOME}/${user}/web/${domain}}"

    [ -z "$user" ] || [ -z "$domain" ] || [ -z "$version" ] || [ -z "$doc_root" ] || [ -z "$socket" ] && usage

    local pool_name="${user}_${domain}"
    local pool_dir="/etc/php/${version}/fpm/pool.d"
    local pool_file="${pool_dir}/${pool_name}.conf"

    local user_tmp="${DEFAULT_USER_HOME}/${user}/tmp"
    mkdir -p "$user_tmp"
    chown "${user}:${user}" "$user_tmp"
    chmod 750 "$user_tmp"

    mkdir -p "$pool_dir"

    sed -e "s|%POOL_NAME%|${pool_name}|g" \
        -e "s|%USER%|${user}|g" \
        -e "s|%WEB_ROOT%|${web_root}|g" \
        -e "s|%DOC_ROOT%|${doc_root}|g" \
        -e "s|%FPM_SOCKET%|${socket}|g" \
        "$TPL_FILE" > "$pool_file"

    systemctl restart "php${version}-fpm" >/dev/null 2>&1 || systemctl reload "php${version}-fpm" >/dev/null 2>&1

    local wait_count=0
    local timeout_sec=15
    while [ ! -S "$socket" ] && [ "$wait_count" -lt "$timeout_sec" ]; do
        sleep 1
        wait_count=$((wait_count + 1))
    done

    if [ ! -S "$socket" ]; then
        log_error "Timeout: el socket $socket no aparecio en ${timeout_sec}s tras restart de php${version}-fpm"
    else
        log_info "Socket $socket listo en ${wait_count}s"
    fi

    log_info "Pool PHP-FPM $pool_name creado para PHP $version"
    echo "{\"status\":\"success\",\"message\":\"Pool PHP-FPM creado para PHP $version\"}"
}

php_pool_del() {
    local user="$1"
    local domain="$2"
    local version="$3"

    [ -z "$user" ] || [ -z "$domain" ] && usage
    local pool_name="${user}_${domain}"

    IFS="," read -r -a VERSIONS <<< "${AVAILABLE_PHP_VERSIONS:-7.4,8.0,8.1,8.2,8.3,8.4,8.5}"
    for ver in "${VERSIONS[@]}"; do
        local pool_file="/etc/php/${ver}/fpm/pool.d/${pool_name}.conf"
        if [ -f "$pool_file" ]; then
            rm -f "$pool_file"
            systemctl restart "php${ver}-fpm" >/dev/null 2>&1 || systemctl reload "php${ver}-fpm" >/dev/null 2>&1
        fi
    done

    log_info "Pool PHP-FPM $pool_name eliminado"
    echo "{\"status\":\"success\",\"message\":\"Pool PHP-FPM eliminado\"}"
}

php_restart() {
    local version="$1"
    [ -z "$version" ] && usage
    systemctl restart "php${version}-fpm"
    echo "{\"status\":\"success\",\"message\":\"PHP-FPM $version reiniciado\"}"
}

get_ini_val() {
    local file="$1"
    local key="$2"
    local def="$3"
    if [ -f "$file" ]; then
        local line
        line=$(grep -E "^\s*${key}\s*=" "$file" | tail -n 1 | sed -E "s/^\s*${key}\s*=\s*//" | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//' -e 's/^"//' -e 's/"$//')
        if [ -n "$line" ]; then
            echo "$line"
            return
        fi
    fi
    echo "$def"
}

set_ini_val() {
    local file="$1"
    local key="$2"
    local val="$3"

    if [ ! -f "$file" ]; then
        return
    fi

    if grep -q -E "^\s*;?\s*${key}\s*=" "$file"; then
        # Reemplazar existente
        sed -i -E "s/^\s*;?\s*${key}\s*=.*/${key} = ${val}/" "$file"
    else
        # Agregar al final de [PHP]
        sed -i "/^\[PHP\]/a ${key} = ${val}" "$file" 2>/dev/null || echo "${key} = ${val}" >> "$file"
    fi
}

php_get_ini() {
    local version="$1"
    [ -z "$version" ] && exit_error "Version de PHP requerida"

    local ini_file="/etc/php/${version}/fpm/php.ini"
    if [ ! -f "$ini_file" ]; then
        ini_file="/etc/php/${version}/cli/php.ini"
    fi

    if [ ! -f "$ini_file" ]; then
        exit_error "Archivo php.ini no encontrado para PHP $version"
    fi

    local max_exec
    max_exec=$(get_ini_val "$ini_file" "max_execution_time" "30")
    local max_input
    max_input=$(get_ini_val "$ini_file" "max_input_time" "60")
    local mem_limit
    mem_limit=$(get_ini_val "$ini_file" "memory_limit" "128M")
    local err_rep
    err_rep=$(get_ini_val "$ini_file" "error_reporting" "E_ALL & ~E_DEPRECATED & ~E_STRICT")
    local disp_err
    disp_err=$(get_ini_val "$ini_file" "display_errors" "Off")
    local post_max
    post_max=$(get_ini_val "$ini_file" "post_max_size" "8M")
    local upload_max
    upload_max=$(get_ini_val "$ini_file" "upload_max_filesize" "2M")

    local b64_content
    b64_content=$(base64 -w 0 "$ini_file" 2>/dev/null || base64 "$ini_file" | tr -d '\r\n')

    echo "{\"status\":\"success\",\"version\":\"$version\",\"ini_file\":\"$ini_file\",\"max_execution_time\":\"$max_exec\",\"max_input_time\":\"$max_input\",\"memory_limit\":\"$mem_limit\",\"error_reporting\":\"$(json_escape "$err_rep")\",\"display_errors\":\"$disp_err\",\"post_max_size\":\"$post_max\",\"upload_max_filesize\":\"$upload_max\",\"raw_base64\":\"$b64_content\"}"
}

php_set_ini() {
    local version="$1"
    local max_exec="$2"
    local max_input="$3"
    local mem_limit="$4"
    local err_rep="$5"
    local disp_err="$6"
    local post_max="$7"
    local upload_max="$8"

    [ -z "$version" ] && exit_error "Version de PHP requerida"

    local ini_file="/etc/php/${version}/fpm/php.ini"
    [ ! -f "$ini_file" ] && ini_file="/etc/php/${version}/cli/php.ini"
    [ ! -f "$ini_file" ] && exit_error "Archivo php.ini no encontrado para PHP $version"

    log_info "Actualizando directivas de PHP $version en $ini_file..."

    [ -n "$max_exec" ] && set_ini_val "$ini_file" "max_execution_time" "$max_exec"
    [ -n "$max_input" ] && set_ini_val "$ini_file" "max_input_time" "$max_input"
    [ -n "$mem_limit" ] && set_ini_val "$ini_file" "memory_limit" "$mem_limit"
    [ -n "$err_rep" ] && set_ini_val "$ini_file" "error_reporting" "$err_rep"
    [ -n "$disp_err" ] && set_ini_val "$ini_file" "display_errors" "$disp_err"
    [ -n "$post_max" ] && set_ini_val "$ini_file" "post_max_size" "$post_max"
    [ -n "$upload_max" ] && set_ini_val "$ini_file" "upload_max_filesize" "$upload_max"

    systemctl restart "php${version}-fpm" >/dev/null 2>&1 || true

    echo "{\"status\":\"success\",\"message\":\"Configuracion de PHP $version actualizada y servicio reiniciado exitosamente\"}"
}

php_save_raw_ini() {
    local version="$1"
    local b64_content="$2"

    [ -z "$version" ] && exit_error "Version de PHP requerida"

    local ini_file="/etc/php/${version}/fpm/php.ini"
    [ ! -f "$ini_file" ] && ini_file="/etc/php/${version}/cli/php.ini"
    [ ! -f "$ini_file" ] && exit_error "Archivo php.ini no encontrado para PHP $version"

    log_info "Guardando archivo php.ini completo para PHP $version..."

    if [ -n "$b64_content" ]; then
        echo "$b64_content" | base64 -d > "$ini_file"
    else
        cat > "$ini_file"
    fi

    systemctl restart "php${version}-fpm" >/dev/null 2>&1 || true

    echo "{\"status\":\"success\",\"message\":\"Archivo php.ini guardado y PHP $version reiniciado exitosamente\"}"
}

php_install() {
    local version="$1"
    [ -z "$version" ] && exit_error "Version de PHP requerida"

    log_info "Iniciando instalacion bajo demanda de PHP $version y extensiones..."

    DEBIAN_FRONTEND=noninteractive apt-get update >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        "php${version}-fpm" "php${version}-cli" "php${version}-mysql" "php${version}-common" \
        "php${version}-mbstring" "php${version}-xml" "php${version}-curl" "php${version}-zip" \
        "php${version}-gd" "php${version}-sqlite3" "php${version}-imagick" "php${version}-intl" \
        "php${version}-bcmath"

    if [ $? -ne 0 ]; then
        exit_error "Error al instalar los paquetes de PHP $version mediante apt"
    fi

    if systemctl list-unit-files | grep -q "php${version}-fpm"; then
        systemctl enable "php${version}-fpm" >/dev/null 2>&1 || true
        systemctl restart "php${version}-fpm" >/dev/null 2>&1 || true
    fi

    log_info "PHP $version instalado y servicio activado exitosamente"
    echo "{\"status\":\"success\",\"message\":\"PHP $version instalado y activado exitosamente\"}"
}

php_remove() {
    local version="$1"
    [ -z "$version" ] && exit_error "Version de PHP requerida"

    if [ "$version" = "8.5" ]; then
        exit_error "No se permite desinstalar la version base del panel (PHP 8.5)"
    fi

    log_info "Desinstalando version PHP $version..."

    systemctl stop "php${version}-fpm" >/dev/null 2>&1 || true
    systemctl disable "php${version}-fpm" >/dev/null 2>&1 || true

    DEBIAN_FRONTEND=noninteractive apt-get purge -y "php${version}*" >/dev/null 2>&1 || true
    rm -rf "/etc/php/${version}"

    log_info "PHP $version desinstalado exitosamente"
    echo "{\"status\":\"success\",\"message\":\"PHP $version desinstalado exitosamente del servidor\"}"
}

php_logs() {
    local version="$1"
    local lines="${2:-60}"
    [ -z "$version" ] && exit_error "Version de PHP requerida"
    local log_file="/var/log/php${version}-fpm.log"
    [ ! -f "$log_file" ] && log_file="/var/log/pirulugcp/php-fpm.log"
    local content=""
    if [ -f "$log_file" ]; then
        content=$(tail -n "$lines" "$log_file" | base64 -w 0 2>/dev/null || tail -n "$lines" "$log_file" | base64 | tr -d '\r\n')
    fi
    echo "{\"status\":\"success\",\"version\":\"$version\",\"log_file\":\"$log_file\",\"raw_base64\":\"$content\"}"
}

php_extensions() {
    local version="$1"
    [ -z "$version" ] && exit_error "Version de PHP requerida"
    local ext_json="[]"
    if command -v "php${version}" >/dev/null 2>&1; then
        local raw_exts
        raw_exts=$(php${version} -m 2>/dev/null | grep -E '^[a-zA-Z0-9_-]+$' | grep -v -E '^(\[.*\])$' | sort -u)
        local json="["
        local first=1
        while IFS= read -r ext; do
            [ -z "$ext" ] && continue
            [ "$first" -eq 0 ] && json="${json},"
            json="${json}\"${ext}\""
            first=0
        done <<< "$raw_exts"
        json="${json}]"
        ext_json="$json"
    fi
    echo "{\"status\":\"success\",\"version\":\"$version\",\"extensions\":$ext_json}"
}

case "$ACTION" in
    versions)
        php_versions_list
        ;;
    install)
        php_install "$PARAM1"
        ;;
    remove|uninstall)
        php_remove "$PARAM1"
        ;;
    logs)
        php_logs "$PARAM1" "$PARAM2"
        ;;
    extensions)
        php_extensions "$PARAM1"
        ;;
    pool-add)
        php_pool_add "$PARAM1" "$PARAM2" "$PARAM3" "$PARAM4" "$PARAM5" "$PARAM6"
        ;;
    pool-del)
        php_pool_del "$PARAM1" "$PARAM2" "$PARAM3"
        ;;
    restart)
        php_restart "$PARAM1"
        ;;
    get-ini)
        php_get_ini "$PARAM1"
        ;;
    set-ini)
        php_set_ini "$PARAM1" "$PARAM2" "$PARAM3" "$PARAM4" "$PARAM5" "$PARAM6" "$PARAM7" "$PARAM8"
        ;;
    save-raw-ini)
        php_save_raw_ini "$PARAM1" "$PARAM2"
        ;;
    *)
        usage
        ;;
esac
